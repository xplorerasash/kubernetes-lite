# Copy to .env and adjust. Loaded automatically by app/main.py (python-dotenv).

# --- Server ---
K8SLITE_HOST=0.0.0.0
K8SLITE_PORT=5000
FLASK_DEBUG=false

# --- State ---
# SQLite database location (inside the container this lives on a volume)
# K8SLITE_DB=/app/data/kubernetes_lite.db

# --- Maintenance ---
# Where snapshots go and how many to keep
# K8SLITE_BACKUP_DIR=/app/data/backups
# K8SLITE_BACKUP_KEEP=10

# --- Auto-scaling ---
# Seconds between auto-scaling passes (HPA-style CPU-based scaling)
# K8SLITE_AUTOSCALE_INTERVAL=10

# --- Load balancing ---
# Host port range used for per-deployment nginx load balancers
# K8SLITE_LB_PORT_MIN=8000
# K8SLITE_LB_PORT_MAX=8099
